<!-- layout/baseHRIS.html -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description"
          content="BHRIS — Portal Internal Basarnas Surabaya untuk administrasi, kepegawaian, operasional, dan layanan internal pegawai.">
    <title>BHRIS {% block title %}{% endblock %}</title>
    <link rel="shortcut icon" type="image/x-icon"
          href="{{ url_for('static', filename='static_dashboard_1/assets/images/logo-full.png') }}">
    <link rel="stylesheet" type="text/css"
          href="{{ url_for('static', filename='css/hris-ui.css') }}">
    <link rel="stylesheet" type="text/css"
          href="{{ url_for('static', filename='static_dashboard_1/assets/vendors/css/feather.min.css') }}">
    <link rel="stylesheet" type="text/css"
          href="{{ url_for('static', filename='static_dashboard_1/assets/vendors/css/bsicon.min.css') }}">
    {% block styles %}{% endblock %}
</head>

<body class="hris-modern hris-app-shell">
    {% include 'partials/nav_hris.html' %}

    <div class="hris-app-main">
        <header class="hris-app-topbar">
            <div class="hris-app-topbar-left">
                <button type="button" class="hris-mobile-menu" id="hrisMobileMenu"
                        aria-label="Buka menu">
                    <i class="feather-menu"></i>
                </button>
                <div class="hris-page-heading">
                    <span class="hris-page-kicker">{% block header_kicker %}HRIS REBORN{% endblock %}</span>
                    <h1>{% block header_title %}Dashboard{% endblock %}</h1>
                </div>
            </div>

            <div class="hris-account">
                <button type="button" class="hris-account-toggle" id="hrisAccountToggle"
                        aria-expanded="false" aria-label="Buka menu akun">
                    <span class="hris-account-avatar" style="overflow:hidden;padding:0;">
                        <img src="{{ url_for('main.api_profilku_photo_route') }}"
                             alt="Foto profil"
                             style="width:100%;height:100%;object-fit:cover;"
                             onerror="this.style.display='none'; this.parentElement.textContent='{{ session.get('nama', 'G')[:1]|upper }}';">
                    </span>
                    <span class="hris-account-name">{{ session.get('nama', 'Guest') }}</span>
                    <i class="feather-chevron-down hris-account-chevron"></i>
                </button>

                <div class="hris-account-dropdown" id="hrisAccountDropdown">
                    <div class="hris-account-info">
                        <strong>{{ session.get('nama', 'Guest') }}</strong>
                        <span>{{ session.get('nip', '') }}</span>
                    </div>
                    <button type="button" class="hris-account-logout" id="hrisSignOutBtn">
                        <i class="feather-log-out"></i>
                        <span>Logout</span>
                    </button>
                </div>
            </div>
        </header>

        <main class="hris-main-v2" id="hrisMain">
            {% block content %}{% endblock %}
        </main>
    </div>

    <div class="hris-mobile-overlay" id="hrisMobileOverlay"></div>

    <script>
        (function () {
            const body = document.body;
            const sidebar = document.getElementById('hrisSidebar');
            const sidebarToggle = document.getElementById('hrisSidebarToggle');
            const mobileMenu = document.getElementById('hrisMobileMenu');
            const mobileOverlay = document.getElementById('hrisMobileOverlay');
            const accountToggle = document.getElementById('hrisAccountToggle');
            const accountDropdown = document.getElementById('hrisAccountDropdown');
            const signOut = document.getElementById('hrisSignOutBtn');

            function setMini(mini) {
                body.classList.toggle('hris-sidebar-mini', mini);
                localStorage.setItem('hris-sidebar-mini', mini ? '1' : '0');
            }

            function setMobile(open) {
                body.classList.toggle('hris-mobile-open', open);
            }

            if (localStorage.getItem('hris-sidebar-mini') === '1') {
                setMini(true);
            }

            sidebarToggle?.addEventListener('click', function () {
                setMini(!body.classList.contains('hris-sidebar-mini'));
            });

            mobileMenu?.addEventListener('click', function () {
                setMobile(true);
            });

            mobileOverlay?.addEventListener('click', function () {
                setMobile(false);
            });

            document.querySelectorAll('.hris-nav-group > .hris-nav-link').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    const group = link.closest('.hris-nav-group');
                    const arrow = event.target.closest('.hris-nav-arrow');

                    // Parent menu tetap menjadi link navigasi (mis. Dashboard -> Infografis).
                    // Hanya tombol panah yang membuka/menutup submenu.
                    if (arrow && group) {
                        event.preventDefault();
                        event.stopPropagation();

                        const isOpen = group.classList.toggle('hris-open');
                        link.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                        return;
                    }

                    // Menu tanpa halaman tujuan berfungsi sebagai accordion.
                    const href = link.getAttribute('href') || '';
                    if (!href || href === 'javascript:void(0);' || href === '#') {
                        event.preventDefault();
                        if (group) {
                            const isOpen = group.classList.toggle('hris-open');
                            link.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                        }
                    }
                });
            });

            // Restore the current menu and keep its parent open after navigation.
            const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
            document.querySelectorAll('.hris-submenu .hris-nav-link').forEach(function (link) {
                const href = link.getAttribute('href') || '';
                if (!href || href === 'javascript:void(0);' || href === '#') return;
                try {
                    const linkPath = new URL(href, window.location.origin).pathname.replace(/\/$/, '') || '/';
                    if (linkPath === currentPath) {
                        link.classList.add('hris-active');
                        link.closest('.hris-nav-group')?.classList.add('hris-open');
                    }
                } catch (err) {}
            });

            document.querySelectorAll('.hris-nav-group > .hris-nav-link').forEach(function (link) {
                const href = link.getAttribute('href') || '';
                if (!href || href === 'javascript:void(0);' || href === '#') return;
                try {
                    const linkPath = new URL(href, window.location.origin).pathname.replace(/\/$/, '') || '/';
                    if (linkPath === currentPath) {
                        link.classList.add('hris-active');
                    }
                } catch (err) {}
            });

            document.querySelectorAll('.hris-submenu .hris-nav-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    setMobile(false);
                });
            });

            accountToggle?.addEventListener('click', function (event) {
                event.stopPropagation();
                const open = !accountDropdown.classList.contains('is-open');
                accountDropdown.classList.toggle('is-open', open);
                accountToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });

            document.addEventListener('click', function (event) {
                if (!event.target.closest('.hris-account')) {
                    accountDropdown?.classList.remove('is-open');
                    accountToggle?.setAttribute('aria-expanded', 'false');
                }
            });

            signOut?.addEventListener('click', async function () {
                try {
                    await fetch('/api/logout', { method: 'POST' });
                } catch (err) {
                    console.error('Gagal logout:', err);
                } finally {
                    window.location.href = "{{ url_for('main.index') }}";
                }
            });
        })();
    </script>

    {# 
       Global script standard:
       - New pages may provide raw JavaScript inside {% block script %}.
       - Legacy pages that still include <script>...</script> are also supported.
       - The wrapper below normalizes both forms into exactly ONE script tag.
    #}
    <script>
        {% filter replace('<script>', '') | replace('</script>', '') %}
            {% block script %}{% endblock %}
        {% endfilter %}
    </script>
</body>
</html>
