<!-- pages/dashboard_2/Data_Siaga_Jadwal_Ulang.html -->
{% extends "layout/baseDashboard2.html" %}

{% block title %}- Ubah Jadwal Piket{% endblock %}

{% block content %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/hris-ui.css') }}">

<div class="hris-modern">
    <div class="hris-page">
        <div class="hris-page-header">
            <div>
                <h1 class="hris-page-title"><i class="bi bi-arrow-repeat"></i> Ubah Jadwal Piket</h1>
                <p class="hris-page-subtitle">Kelola personel piket, status kehadiran, dan pemulihan jadwal dengan aman.</p>
            </div>
        </div>

        <div id="alertContainer" class="d-none" role="status" aria-live="polite" style="margin-bottom:16px;">
            <div class="hris-card">
                <div class="hris-card-body" style="padding:12px 16px;">
                    <span id="alertMessage"></span>
                </div>
            </div>
        </div>

        <section class="hris-card jadwal-card" aria-labelledby="jadwalFilterTitle">
            <div class="hris-card-header">
                <div>
                    <h2 class="hris-card-title" id="jadwalFilterTitle"><i class="bi bi-funnel"></i> Filter Jadwal Piket</h2>
                    <p class="hris-page-subtitle">Pilih unit kerja, tanggal, dan shift untuk memuat jadwal yang akan dikelola.</p>
                </div>
            </div>
            <div class="hris-card-body">
                <div class="jadwal-filter-grid">
                    <div class="hris-field jadwal-filter-date">
                        <label class="hris-label" for="tglJadwal"><i class="bi bi-calendar3"></i> Tanggal Jadwal</label>
                        <input type="date" id="tglJadwal" class="hris-input">
                    </div>
                    <div class="hris-field jadwal-filter-unit">
                        <label class="hris-label" for="unitKerja"><i class="bi bi-building"></i> Unit Kerja</label>
                        <select id="unitKerja" class="hris-select">
                            <option value="">Pilih unit kerja...</option>
                        </select>
                    </div>
                    <div class="hris-field jadwal-filter-shift">
                        <label class="hris-label" for="shift"><i class="bi bi-clock"></i> Shift</label>
                        <select id="shift" class="hris-select">
                            <option value="">Pilih shift...</option>
                        </select>
                    </div>
                    <div class="jadwal-filter-actions">
                        <button type="button" class="hris-btn hris-btn-primary" id="btnShow"><i class="bi bi-search"></i><span>Tampilkan</span></button>
                        <button type="button" class="hris-btn hris-btn-secondary" id="btnReset"><i class="bi bi-arrow-counterclockwise"></i><span>Reset Jadwal</span></button>
                    </div>
                </div>
                <p class="jadwal-filter-hint"><i class="bi bi-info-circle"></i> Muat jadwal terlebih dahulu sebelum mengubah, menghapus, menambah, atau memulihkan personel.</p>
            </div>
        </section>

        <section class="hris-card jadwal-card" aria-labelledby="jadwalListTitle">
            <div class="hris-card-header">
                <div>
                    <h2 class="hris-card-title" id="jadwalListTitle"><i class="bi bi-people"></i> Daftar Personel Piket</h2>
                    <p class="hris-page-subtitle">Personel yang tercatat pada unit, tanggal, dan shift terpilih.</p>
                </div>
                <span id="infoJadwal" class="jadwal-count"></span>
            </div>
            <div class="hris-table-wrap">
                <table class="hris-table-modern" id="tableJadwal">
                    <thead>
                        <tr>
                            <th style="width:56px;text-align:center;">No</th>
                            <th>NIP</th>
                            <th>Nama</th>
                            <th>Fungsional</th>
                            <th>Status</th>
                            <th style="width:125px;text-align:center;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyJadwal">
                        <tr><td colspan="6" class="jadwal-empty"><i class="bi bi-funnel"></i>Pilih unit kerja, tanggal, dan shift, lalu klik Tampilkan.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="hris-card jadwal-card" aria-labelledby="jadwalRollbackTitle">
            <div class="hris-card-header">
                <div>
                    <h2 class="hris-card-title" id="jadwalRollbackTitle"><i class="bi bi-arrow-counterclockwise"></i> Pemulihan Personel Terhapus</h2>
                    <p class="hris-page-subtitle">Pulihkan personel dari catatan backup jadwal yang tersedia.</p>
                </div>
            </div>
            <div class="hris-table-wrap">
                <table class="hris-table-modern" id="tableRollback">
                    <thead>
                        <tr>
                            <th style="width:56px;text-align:center;">No</th>
                            <th>NIP</th>
                            <th>Nama</th>
                            <th>Fungsional</th>
                            <th style="width:140px;text-align:center;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyRollback">
                        <tr><td colspan="5" class="jadwal-empty"><i class="bi bi-archive"></i>Data pemulihan akan tampil setelah jadwal dimuat.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="hris-card jadwal-card" aria-labelledby="jadwalAddTitle">
            <div class="hris-card-header">
                <div>
                    <h2 class="hris-card-title" id="jadwalAddTitle"><i class="bi bi-person-plus"></i> Tambah Personel Piket</h2>
                    <p class="hris-page-subtitle">Cari pegawai dan tentukan fungsional untuk jadwal yang sudah dimuat.</p>
                </div>
            </div>
            <div class="hris-card-body">
                <div class="jadwal-add-grid">
                    <div class="hris-field position-relative">
                        <label class="hris-label" for="searchPegawai">Nama Personel</label>
                        <input type="text" id="searchPegawai" class="hris-input" placeholder="Cari nama atau NIP pegawai..." autocomplete="off">
                        <div id="pegawaiDropdown" class="dropdown-menu w-100" style="display:none;max-height:240px;overflow-y:auto;position:absolute;z-index:1050;"></div>
                        <input type="hidden" id="selectedNIP">
                    </div>
                    <div class="hris-field">
                        <label class="hris-label" for="fungsionalAdd">Fungsional Piket</label>
                        <select id="fungsionalAdd" class="hris-select">
                            <option value="">Pilih fungsional...</option>
                        </select>
                    </div>
                    <div class="jadwal-add-submit">
                        <button type="button" class="hris-btn hris-btn-primary" id="btnAddPersonil"><i class="bi bi-person-plus"></i><span>Tambah Personel</span></button>
                    </div>
                </div>
                <p class="jadwal-filter-hint"><i class="bi bi-shield-check"></i> Pastikan filter jadwal dan fungsional sudah sesuai sebelum menambahkan personel.</p>
            </div>
        </section>
    </div>
</div>

<!-- Modal Pengganti Petugas -->
<div class="modal fade" id="replacementModal" tabindex="-1" aria-labelledby="replacementModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5 fw-semibold" id="replacementModalTitle"><i class="bi bi-arrow-repeat me-2" style="color:#0f766e;"></i>Ganti Petugas Piket</h2>
                    <p class="mb-0 mt-1 small text-muted">Cari pegawai berdasarkan nama, lalu pilih dari hasil pencarian.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                <div class="replacement-current">
                    <div class="small text-muted mb-1">Petugas saat ini</div>
                    <div class="fw-semibold" id="replacementCurrentName">-</div>
                    <div class="small text-muted" id="replacementCurrentRole">-</div>
                </div>
                <label for="replacementSearch" class="hris-label">Nama pegawai pengganti</label>
                <div class="replacement-search-wrap">
                    <input type="text" class="hris-input" id="replacementSearch" placeholder="Ketik nama pegawai..." autocomplete="off">
                    <div id="replacementSuggestions" role="listbox" aria-label="Hasil pencarian pegawai"></div>
                </div>
                <input type="hidden" id="replacementNip">
                <div class="small text-muted mt-2" id="replacementSearchHint">Ketik minimal 2 karakter untuk mencari pegawai.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="hris-btn hris-btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="hris-btn hris-btn-primary" id="btnConfirmReplacement" disabled><i class="bi bi-person-check me-1"></i>Ganti Petugas</button>
            </div>
        </div>
    </div>
</div>

<style>
    .jadwal-card { margin-bottom:18px; }
    .jadwal-filter-grid { display:grid; grid-template-columns:minmax(165px,.9fr) minmax(300px,2fr) minmax(150px,.8fr) auto; gap:14px; align-items:end; }
    .jadwal-filter-date,.jadwal-filter-unit,.jadwal-filter-shift { min-width:0; }
    .jadwal-filter-actions { display:flex; align-items:end; align-self:end; gap:8px; flex-wrap:nowrap; white-space:nowrap; }
    .jadwal-filter-hint { margin:14px 0 0; color:var(--ui-muted); font-size:12px; }
    .jadwal-filter-hint i { margin-right:5px; color:var(--ui-brand); }
    .jadwal-count { color:var(--ui-muted); font-size:12px; white-space:nowrap; }
    .jadwal-empty { padding:26px 12px !important; text-align:center; color:var(--ui-muted) !important; font-size:13px !important; }
    .jadwal-empty i { margin-right:7px; color:#a3afbf; }
    .jadwal-add-grid { display:grid; grid-template-columns:minmax(240px,1.3fr) minmax(200px,1fr) auto; gap:16px; align-items:end; }
    .jadwal-add-submit .hris-btn { min-height:38px; white-space:nowrap; }
    #pegawaiDropdown { border:1px solid var(--ui-border); border-radius:8px; box-shadow:var(--ui-shadow); }
    #pegawaiDropdown .pegawai-item { cursor:pointer; padding:9px 12px; white-space:normal; }
    #pegawaiDropdown .pegawai-item:hover { background:#fff5ef; }
    #tableJadwal { table-layout:auto; }
    #tableBodyJadwal tr { height:38px; }
    #tableBodyJadwal td { padding:5px 10px !important; vertical-align:middle; line-height:1.2; white-space:nowrap; }
    #tableBodyJadwal td:nth-child(3) { min-width:220px; }
    #tableBodyJadwal .jadwal-action-cell { white-space:nowrap; text-align:center; }
    #tableBodyJadwal .jadwal-action-group { display:inline-flex; flex-flow:row nowrap; align-items:center; justify-content:center; gap:8px; white-space:nowrap; }
    #tableBodyJadwal .btn-action,#tableBodyRollback .btn-action { display:inline-flex; align-items:center; justify-content:center; min-height:30px; min-width:32px; padding:5px 8px; border-radius:8px; margin:0; vertical-align:middle; flex:0 0 auto; }
    #tableBodyJadwal .btn-edit-jadwal { color:#0f766e; border-color:#0f766e; }
    #tableBodyJadwal .btn-edit-jadwal:hover { color:#fff; background:#0f766e; border-color:#0f766e; }
    #tableBodyJadwal .btn-edit-jadwal i { font-size:17px; }
    #replacementModal .modal-dialog { max-width:520px; }
    #replacementModal .modal-content { border:1px solid rgba(226,232,240,.9); border-radius:18px; background:rgba(255,255,255,.96); box-shadow:0 24px 80px rgba(15,23,42,.24); overflow:visible; }
    #replacementModal .modal-header { padding:20px 22px 14px; border-bottom:1px solid #edf0f5; }
    #replacementModal .modal-body { padding:20px 22px; }
    #replacementModal .modal-footer { padding:14px 22px 20px; border-top:1px solid #edf0f5; gap:8px; }
    #replacementModal .replacement-current { background:#f8fafc; border:1px solid #e8edf4; border-radius:12px; padding:12px 14px; margin-bottom:18px; }
    #replacementModal .replacement-search-wrap { position:relative; }
    #replacementSuggestions { display:none; position:absolute; inset:calc(100% + 6px) 0 auto; z-index:1085; max-height:240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:12px; background:#fff; box-shadow:0 14px 35px rgba(15,23,42,.15); }
    #replacementSuggestions .replacement-option { display:block; width:100%; padding:11px 14px; border:0; border-bottom:1px solid #f1f5f9; background:#fff; text-align:left; color:#1e293b; }
    #replacementSuggestions .replacement-option:hover,#replacementSuggestions .replacement-option:focus { background:#fff4ed; outline:0; }
    #replacementSuggestions .replacement-option small { display:block; margin-top:3px; color:#64748b; }
    /* Paksa modal ke layer teratas; blur hanya diterapkan pada backdrop di belakang modal. */
    body.modal-open .modal-backdrop { z-index:19990 !important; background:rgba(15,23,42,.30) !important; opacity:1 !important; backdrop-filter:blur(5px); -webkit-backdrop-filter:blur(5px); }
    #replacementModal { z-index:20000 !important; position:fixed !important; inset:0; overflow-y:auto; }
    #replacementModal .modal-dialog { position:relative; z-index:20001; margin-left:auto; margin-right:auto; }
    #replacementModal .modal-content { position:relative; z-index:20002; background:#fff; }
    #replacementSuggestions { z-index:20010; }
    @media(max-width:1100px) { .jadwal-filter-grid { grid-template-columns:minmax(150px,.85fr) minmax(230px,1.5fr) minmax(135px,.8fr); } .jadwal-filter-actions { grid-column:1/-1; flex-wrap:wrap; } }
    @media(max-width:700px) { .hris-page { padding:15px; } .jadwal-filter-grid,.jadwal-add-grid { grid-template-columns:minmax(0,1fr); } .jadwal-filter-actions { grid-column:auto; } .jadwal-filter-actions .hris-btn { flex:1; } }
</style>
{% endblock %}



{% block script %}
<script>
$(document).ready(function() {
    let guidLog = '';
    let jadwalData = [];
    let rollbackData = [];

    // Gunakan input tanggal native; hindari clone elemen dan mematikan plugin global.
    const now = new Date();
    const localToday = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    $('#tglJadwal').val(localToday);
    // ============================================
    // LOAD UNIT KERJA & SHIFT
    // ============================================
    // API Master Unit Kerja mengembalikan {status:'success', data:[{unit_kerja_id,nama_unit_kerja,...}]}
    $.get('/api/unit-kerja/list')
        .done(function(r) {
            const rows = Array.isArray(r.data) ? r.data : [];
            const $unit = $('#unitKerja').empty().append('<option value="">Pilih unit kerja...</option>');
            rows.forEach(function(u) {
                const id = u.unit_kerja_id ?? u.UNIT_KERJA_ID;
                const name = u.nama_unit_kerja ?? u.NAMA_UNIT_KERJA;
                const isUse = u.is_use ?? u.IS_USE;
                if (id !== undefined && id !== null && name && (isUse === undefined || ['Y', '1', 1, true].includes(isUse))) {
                    $unit.append($('<option>', { value: String(id), text: String(name) }));
                }
            });
            if (!rows.length) {
                showAlert('warning', 'Master unit kerja tidak mengembalikan data.');
            }
        })
        .fail(function(xhr) {
            showAlert('danger', 'Gagal memuat unit kerja (' + xhr.status + ').');
        });

    // Ambil master shift. Jika master lama gagal/tidak berisi data, fallback
    // ke dua nilai shift yang dipakai HRIS 2013: 1 dan 2.
    function populateShiftOptions(rows) {
        const $shift = $('#shift').empty().append('<option value="">Pilih shift...</option>');
        const validRows = (Array.isArray(rows) ? rows : []).filter(function(s) {
            const id = s.id ?? s.shift_id ?? s.SHIFT_ID;
            const name = s.nama ?? s.nama_shift ?? s.NAMA_SHIFT;
            return id !== undefined && id !== null && String(name || '').trim() !== '';
        });
        if (validRows.length) {
            validRows.forEach(function(s) {
                const id = s.id ?? s.shift_id ?? s.SHIFT_ID;
                const name = s.nama ?? s.nama_shift ?? s.NAMA_SHIFT;
                $shift.append($('<option>', { value: String(id), text: String(name) }));
            });
        } else {
            $shift.append('<option value="1">Shift 1</option><option value="2">Shift 2</option>');
        }
    }

    $.get('/api/rejadwal-siaga/shift')
        .done(function(r) {
            populateShiftOptions(r && r.success ? r.data : []);
            if (!(r && r.success && Array.isArray(r.data) && r.data.length)) {
                console.warn('Master shift kosong/gagal; memakai opsi Shift 1 dan Shift 2.');
            }
        })
        .fail(function(xhr) {
            populateShiftOptions([]);
            console.warn('API master shift gagal (' + xhr.status + '); memakai opsi Shift 1 dan Shift 2.');
        });

    $.get('/api/rejadwal-siaga/fungsional', function(r) {
        if (r.success && r.data) {
            r.data.forEach(function(f) {
                $('#fungsionalAdd').append(`<option value="${f}">${f}</option>`);
            });
        }
    });

    // ============================================
    // SHOW JADWAL
    // ============================================
    $('#btnShow').on('click', function() {
        const unit = $('#unitKerja').val();
        const tgl = $('#tglJadwal').val();
        const shift = $('#shift').val();

        if (!unit || !tgl || !shift) {
            showAlert('warning', 'Unit, Tanggal, dan Shift harus diisi!');
            return;
        }

        const $btn = $(this).prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>Loading...');

        $.get('/api/rejadwal-siaga/get-jadwal', {
            unit_kerja_id: unit,
            tgl: tgl,
            shift: shift
        }).done(function(r) {
            console.log('Jadwal Ulang response:', r);
            if (r && r.success) {
                guidLog = r.guid_log || '';
                jadwalData = Array.isArray(r.jadwal) ? r.jadwal : [];
                rollbackData = Array.isArray(r.rollback) ? r.rollback : [];
                $('#infoJadwal').text(jadwalData.length + ' personel');
                renderJadwal();
                renderRollback();
                if (!jadwalData.length) {
                    showAlert('warning', r.message || 'Jadwal tidak ditemukan untuk unit, tanggal, dan shift ini.');
                } else {
                    showAlert('success', 'Jadwal berhasil dimuat: ' + jadwalData.length + ' personel.');
                }
            } else {
                guidLog = '';
                jadwalData = [];
                rollbackData = [];
                renderJadwal();
                renderRollback();
                showAlert('warning', (r && r.error) || 'Jadwal tidak ditemukan.');
            }
        }).fail(function(xhr) {
            let msg = 'Gagal memuat jadwal.';
            try {
                const response = JSON.parse(xhr.responseText);
                msg = response.error || msg;
            } catch (e) {}
            showAlert('danger', msg + ' (HTTP ' + xhr.status + ')');
        }).always(function() {
            $btn.prop('disabled', false).html('<i class="bi bi-search"></i><span>Tampilkan</span>');
        });
    });

    // ============================================
    // RENDER JADWAL
    // ============================================
    function renderJadwal() {
        const $tbody = $('#tableBodyJadwal').empty();
        if (!jadwalData.length) {
            $tbody.html('<tr><td colspan="6" class="py-4 text-muted">Tidak ada data</td></tr>');
            return;
        }
        jadwalData.forEach(function(row) {
            const statusBadge = row.status_id === 3 ? 'bg-success' : 
                               (row.status_id === 0 ? 'bg-danger' : 
                               (row.status_id === 2 ? 'bg-warning' : 'bg-secondary'));
            
            $tbody.append(`
                <tr data-guid="${row.guid_log}" data-nip="${row.nip}" data-act="${row.act_date}" data-shift="${row.shift}">
                    <td>${row.no}</td>
                    <td>${row.nip}</td>
                    <td class="text-start">${row.nama}</td>
                    <td>${row.fungsional}</td>
                    <td><span class="badge ${statusBadge}">${row.status || '-'}</span></td>
                    <td class="jadwal-action-cell">
                        <div class="jadwal-action-group">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-action btn-edit-jadwal" title="Ganti petugas" aria-label="Ganti petugas">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-action btn-delete-jadwal" title="Hapus dari jadwal" aria-label="Hapus dari jadwal">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `);
        });
    }

    // ============================================
    // RENDER ROLLBACK
    // ============================================
    function renderRollback() {
        const $tbody = $('#tableBodyRollback').empty();
        if (!rollbackData.length) {
            $tbody.html('<tr><td colspan="5" class="py-4 text-muted">Tidak ada data rollback</td></tr>');
            return;
        }
        rollbackData.forEach(function(row) {
            $tbody.append(`
                <tr data-nip="${row.nip}" data-id="${row.id_backup}" data-act="${row.act_date}" data-shift="${row.shift}">
                    <td>${row.no}</td>
                    <td>${row.nip}</td>
                    <td class="text-start">${row.nama}</td>
                    <td>${row.fungsional}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-success btn-action btn-rollback" title="Rollback personil">
                            <i class="bi bi-arrow-counterclockwise"></i> Rollback
                        </button>
                    </td>
                </tr>
            `);
        });
    }

    // ============================================
    // DELETE JADWAL (CloseData)
    // ============================================
    $('#tableBodyJadwal').on('click', '.btn-delete-jadwal', function() {
        const $row = $(this).closest('tr');
        const nip = $row.data('nip');
        const actDate = $row.data('act');
        const shift = $row.data('shift');

        if (!confirm(`Hapus ${nip} dari jadwal?`)) return;

        $.ajax({
            url: '/api/rejadwal-siaga/delete-personil',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ guid_log: guidLog, nip: nip, act_date: actDate, shift: shift }),
            success: function(r) {
                if (r.success) {
                    showAlert('success', r.message);
                    $('#btnShow').click();
                } else {
                    showAlert('danger', r.error || 'Gagal menghapus');
                }
            },
            error: function() { showAlert('danger', 'Gagal menghapus'); }
        });
    });

    // ============================================
    // GANTI PETUGAS — pilih nama dari autocomplete, NIP hanya dipakai internal.
    let replacementRow = null;
    let replacementSearchTimer = null;
    const replacementModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('replacementModal'));

    $('#tableBodyJadwal').on('click', '.btn-edit-jadwal', function() {
        replacementRow = $(this).closest('tr');
        const oldNip = String(replacementRow.data('nip') || '').trim();
        const currentName = String(replacementRow.find('td').eq(2).text() || '').trim();
        const currentRole = String(replacementRow.find('td').eq(3).text() || '').trim();

        $('#replacementCurrentName').text(currentName || oldNip);
        $('#replacementCurrentRole').text((currentRole ? currentRole + ' • ' : '') + 'Petugas saat ini');
        $('#replacementSearch').val('');
        $('#replacementNip').val('');
        $('#replacementSuggestions').empty().hide();
        $('#replacementSearchHint').text('Ketik minimal 2 karakter untuk mencari pegawai.');
        $('#btnConfirmReplacement').prop('disabled', true);
        replacementModal.show();
        setTimeout(() => $('#replacementSearch').trigger('focus'), 180);
    });

    $('#replacementSearch').on('input', function() {
        clearTimeout(replacementSearchTimer);
        const keyword = String($(this).val() || '').trim();
        $('#replacementNip').val('');
        $('#btnConfirmReplacement').prop('disabled', true);
        const $suggestions = $('#replacementSuggestions').empty();

        if (keyword.length < 2) {
            $suggestions.hide();
            $('#replacementSearchHint').text('Ketik minimal 2 karakter untuk mencari pegawai.');
            return;
        }

        $('#replacementSearchHint').text('Mencari pegawai...');
        replacementSearchTimer = setTimeout(function() {
            $.get('/api/rejadwal-siaga/search-pegawai', { keyword: keyword })
                .done(function(r) {
                    $suggestions.empty();
                    if (r && r.success && Array.isArray(r.data) && r.data.length) {
                        r.data.forEach(function(person) {
                            const $option = $('<button>', {
                                type: 'button',
                                class: 'replacement-option',
                                role: 'option'
                            });
                            $('<span>').addClass('fw-semibold').text(person.nama || '-').appendTo($option);
                            $('<small>').text('NIP: ' + (person.nip || '-')).appendTo($option);
                            $option.data('person', person);
                            $suggestions.append($option);
                        });
                        $suggestions.show();
                        $('#replacementSearchHint').text('Pilih nama pegawai dari daftar hasil pencarian.');
                    } else {
                        $suggestions.html('<div class="px-3 py-3 small text-muted">Pegawai tidak ditemukan.</div>').show();
                        $('#replacementSearchHint').text('Coba kata kunci nama yang lain.');
                    }
                })
                .fail(function() {
                    $suggestions.html('<div class="px-3 py-3 small text-danger">Pencarian gagal. Silakan coba lagi.</div>').show();
                    $('#replacementSearchHint').text('Tidak dapat menghubungi layanan pencarian.');
                });
        }, 250);
    });

    $('#replacementSuggestions').on('click', '.replacement-option', function() {
        const person = $(this).data('person');
        if (!person) return;
        $('#replacementSearch').val(person.nama || '');
        $('#replacementNip').val(person.nip || '');
        $('#replacementSuggestions').hide().empty();
        $('#replacementSearchHint').text('Pegawai dipilih. Periksa nama sebelum menyimpan.');
        $('#btnConfirmReplacement').prop('disabled', !person.nip);
    });

    $('#btnConfirmReplacement').on('click', function() {
        if (!replacementRow) return;
        const $row = replacementRow;
        const oldNip = String($row.data('nip') || '').trim();
        const actDate = String($row.data('act') || '').trim();
        const shift = String($row.data('shift') || '').trim();
        const newNip = String($('#replacementNip').val() || '').trim();
        const newName = String($('#replacementSearch').val() || '').trim();

        if (!newNip || !newName) {
            $('#replacementSearchHint').text('Pilih nama pegawai dari daftar pencarian terlebih dahulu.');
            return;
        }
        if (newNip === oldNip) {
            $('#replacementSearchHint').text('Pegawai pengganti sama dengan petugas saat ini.');
            return;
        }

        const $btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Menyimpan...');
        $.ajax({
            url: '/api/rejadwal-siaga/edit-personil',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                guid_log: String($row.data('guid') || guidLog),
                old_nip: oldNip,
                new_nip: newNip,
                act_date: actDate,
                shift: shift
            }),
            success: function(r) {
                if (r && r.success) {
                    replacementModal.hide();
                    showAlert('success', r.message || ('Petugas berhasil diganti dengan ' + newName + '.'));
                    $('#btnShow').click();
                } else {
                    $('#replacementSearchHint').text((r && r.error) || 'Gagal mengganti petugas.');
                }
            },
            error: function(xhr) {
                let msg = 'Gagal mengganti petugas.';
                try { msg = JSON.parse(xhr.responseText).error || msg; } catch (e) {}
                $('#replacementSearchHint').text(msg + ' (HTTP ' + xhr.status + ')');
            },
            complete: function() {
                $btn.prop('disabled', false).html('<i class="bi bi-person-check me-1"></i>Ganti Petugas');
            }
        });
    });

    $('#replacementModal').on('hidden.bs.modal', function() {
        $('#replacementSuggestions').hide().empty();
        replacementRow = null;
    });

    // ============================================
    // ROLLBACK
    // ============================================
    $('#tableBodyRollback').on('click', '.btn-rollback', function() {
        const $row = $(this).closest('tr');
        const nip = $row.data('nip');
        const idBackup = $row.data('id');
        const actDate = $row.data('act');
        const shift = $row.data('shift');

        if (!confirm(`Rollback ${nip} ke jadwal?`)) return;

        $.ajax({
            url: '/api/rejadwal-siaga/rollback',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ guid_log: guidLog, nip: nip, id_backup: String(idBackup), act_date: actDate, shift: shift }),
            success: function(r) {
                if (r.success) {
                    showAlert('success', r.message);
                    $('#btnShow').click();
                } else {
                    showAlert('danger', r.error || 'Gagal rollback');
                }
            },
            error: function() { showAlert('danger', 'Gagal rollback'); }
        });
    });

    // ============================================
    // SEARCH PEGAWAI
    // ============================================
    let searchTimeout;
    $('#searchPegawai').on('input', function() {
        clearTimeout(searchTimeout);
        const keyword = $(this).val().trim();
        if (keyword.length < 1) { $('#pegawaiDropdown').hide(); return; }

        searchTimeout = setTimeout(function() {
            $.get('/api/dinas-luar/search-pegawai', { keyword: keyword }, function(r) {
                const $dd = $('#pegawaiDropdown').empty();
                if (r.data && r.data.length) {
                    r.data.forEach(function(p) {
                        $dd.append(`<a class="dropdown-item pegawai-item" href="#" data-nip="${p.nip}" data-nama="${p.nama}">
                            <strong>${p.nama}</strong> <small class="text-muted">(${p.nip})</small></a>`);
                    });
                    $dd.show();
                } else {
                    $dd.html('<span class="dropdown-item text-muted">Tidak ditemukan</span>').show();
                }
            }).fail(function() {
                $('#pegawaiDropdown').html('<span class="dropdown-item text-danger">Gagal mencari</span>').show();
            });
        }, 300);
    });

    $('#pegawaiDropdown').on('click', '.pegawai-item', function(e) {
        e.preventDefault();
        const nip = $(this).data('nip');
        const nama = $(this).data('nama');
        $('#searchPegawai').val(nama + ' (' + nip + ')');
        $('#selectedNIP').val(nip);
        $('#pegawaiDropdown').hide();
        console.log('✅ Selected:', nip, nama);
    });

    $(document).on('click', function(e) {
        if (!$(e.target).closest('#searchPegawai, #pegawaiDropdown').length) {
            $('#pegawaiDropdown').hide();
        }
    });

    // ============================================
    // TAMBAH PERSONIL (VERSI BARU)
    // ============================================
    $('#btnAddPersonil').on('click', function() {
        const nip = $('#selectedNIP').val();
        const fungsional = $('#fungsionalAdd').val();
        const unit = $('#unitKerja').val();
        const tgl = $('#tglJadwal').val();
        const shift = $('#shift').val();

        if (!guidLog) { 
            showAlert('warning', 'Klik Show terlebih dahulu untuk memuat jadwal!'); 
            return; 
        }
        if (!nip) { 
            showAlert('warning', 'Pilih personil terlebih dahulu!'); 
            return; 
        }
        if (!fungsional) { 
            showAlert('warning', 'Pilih fungsional!'); 
            return; 
        }
        if (!unit || !tgl || !shift) {
            showAlert('warning', 'Unit, Tanggal, dan Shift harus diisi!');
            return;
        }

        const $btn = $(this).prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>Menyimpan...');

        $.ajax({
            url: '/api/rejadwal-siaga/add-personil',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                guid_log: guidLog,
                nip: nip,
                fungsional: fungsional,
                unit_kerja_id: unit,
                tgl: tgl,
                shift: shift
            }),
            success: function(r) {
                if (r.success) {
                    showAlert('success', r.message);
                    
                    // Reset form tambah
                    $('#searchPegawai').val('');
                    $('#selectedNIP').val('');
                    $('#fungsionalAdd').val('');
                    
                    // Refresh jadwal
                    $('#btnShow').click();
                } else {
                    showAlert('danger', r.error || 'Gagal menambahkan personil');
                }
            },
            error: function(xhr) {
                let msg = 'Gagal menambahkan personil';
                try {
                    const r = JSON.parse(xhr.responseText);
                    msg = r.error || msg;
                } catch(e) {}
                showAlert('danger', msg);
            },
            complete: function() {
                $btn.prop('disabled', false).html('<i class="bi bi-person-plus"></i><span>Tambah Personel</span>');
            }
        });
    });

    // RESET JADWAL - alur pemulihan roster HRIS 2013
    $('#btnReset').on('click', function() {
        const unit = $('#unitKerja').val();
        const tgl = $('#tglJadwal').val();
        const shift = $('#shift').val();
        if (!unit || !tgl || !shift) { showAlert('warning', 'Pilih unit, tanggal, dan shift terlebih dahulu.'); return; }
        if (!guidLog) { showAlert('warning', 'Klik Show terlebih dahulu untuk memuat jadwal.'); return; }
        if (!confirm('Reset jadwal untuk unit, tanggal, dan shift ini? Personel pengganti akan dihapus dan roster asli dipulihkan.')) return;
        const $btn = $(this).prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>Memproses...');
        $.ajax({
            url: '/api/rejadwal-siaga/reset', method: 'POST', contentType: 'application/json',
            data: JSON.stringify({ unit_kerja_id: unit, tgl: tgl, shift: shift }),
            success: function(r) {
                if (r.success) { showAlert('success', r.message || 'Reset jadwal berhasil.'); $('#btnShow').trigger('click'); }
                else { showAlert('danger', r.error || 'Reset jadwal gagal.'); }
            },
            error: function(xhr) {
                let msg = 'Reset jadwal gagal.';
                try { msg = (JSON.parse(xhr.responseText) || {}).error || msg; } catch(e) {}
                showAlert('danger', msg);
            },
            complete: function() { $btn.prop('disabled', false).html('<i class="bi bi-arrow-counterclockwise"></i><span>Reset Jadwal</span>'); }
        });
    });

    // ============================================
    // ALERT HELPER
    // ============================================
    function showAlert(type, msg) {
        const a = $('#alertContainer').removeClass('d-none alert-success alert-danger alert-warning alert-info')
            .addClass('alert-' + type).show();
        $('#alertMessage').text(msg);
        setTimeout(function() { a.addClass('d-none').hide(); }, 5000);
    }

    console.log('✅ Jadwal Ulang Piket Siaga - Halaman siap');
});
</script>
{% endblock %}