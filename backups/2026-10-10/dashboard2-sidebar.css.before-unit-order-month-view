}
html.minimenu body.hris-dashboard2 .nxl-navigation .nxl-navbar {
  width: 72px !important;
  padding: 0 8px 18px !important;
}
html.minimenu body.hris-dashboard2 .custom-nav-header .header-container:first-child {
  justify-content: center !important;
  padding: 12px 8px !important;
  gap: 0 !important;
}
html.minimenu body.hris-dashboard2 .custom-nav-header .header-container:first-child img {
  width: 32px !important;
  height: 32px !important;
  flex: 0 0 32px !important;
}
html.minimenu body.hris-dashboard2 .custom-nav-header .header-container:first-child .nav-text-label,
html.minimenu body.hris-dashboard2 .nxl-navigation .nxl-mtext,
html.minimenu body.hris-dashboard2 .nxl-navigation .nxl-arrow {
