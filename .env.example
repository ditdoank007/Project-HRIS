DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=basarnas_db
SECRET_KEY=ganti_dengan_random_string
GOOGLE_CALENDAR_API_KEY="your-api-key-here"

# Central document storage (Synology HRIS-DATA mounted on CT127)
HRIS_DATA_ROOT=/mnt/hris-data

HRIS_TTD_ROOT=/mnt/hris-data/TTD_PEGAWAI
HRIS_PUBLIC_BASE_URL=https://hris.sarsurabaya.id

CALENDAR_PUBLIC_BASE_URL=https://calendar.sarsurabaya.id

# Backup / Restore
HRIS_BACKUP_ROOT=/mnt/hris-data/BACKUP_DB

# MSSQL HRIS 2013 import staging
HRIS_MSSQL_IMPORT_ROOT=/mnt/hris-data/MSSQL_IMPORT
# Point this to the proven INSERT-ONLY MSSQL import worker on the deployment host.
HRIS_MSSQL_IMPORT_SCRIPT=
HRIS_MSSQL_IMPORT_TIMEOUT=7200
MARIADB_DUMP_BIN=mariadb-dump
MARIADB_CLIENT_BIN=mariadb
PYTHON_BIN=python3
